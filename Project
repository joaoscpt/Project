function GetBestWeapon()
    local tools = {}
    for _,v in pairs(Player.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v) end end
    for _,v in pairs(Player.Character:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v) end end
    for _,t in pairs(tools) do if t.ToolTip == "Melee" then return t.Name end end
    for _,t in pairs(tools) do if t.ToolTip == "Sword" then return t.Name end end
    if #tools > 0 then return tools[1].Name end
    return nil
end

-- TWEEN PRA MISSÃO (com bypass se for muito longe tipo Cursed Ship)
function TweenQuest(CF)
    local HRP = Player.Character.HumanoidRootPart
    if (CF.Position - HRP.Position).Magnitude > 8000 then
        HRP.CFrame = CF * CFrame.new(0,20,0)
        task.wait(0.6)
        return
    end
    local Tween = TweenService:Create(HRP, TweenInfo.new((CF.Position - HRP.Position).Magnitude/280, Enum.EasingStyle.Linear), {CFrame = CF})
    Tween:Play() Tween.Completed:Wait()
end

-- TWEEN PRA FICAR EM CIMA DO MOB (SEM TP)
function TweenMob(CF)
    local HRP = Player.Character.HumanoidRootPart
    local Dist = (CF.Position - HRP.Position).Magnitude
    local Tween = TweenService:Create(HRP, TweenInfo.new(Dist/150, Enum.EasingStyle.Linear), {CFrame = CF})
    Tween:Play()
end

