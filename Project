function GetQuest()
    local MyLevel = Player.Data.Level.Value
    local Q = QuestTable[1]
    for i = #QuestTable, 1, -1 do if MyLevel >= QuestTable[i].L then Q = QuestTable[i] break end end
    return Q
end

local MainTab = Window:CreateTab("Auto Farm", 4483362458)
local Status = MainTab:CreateLabel("MAX 2800 | Tween + Kill Aura")

MainTab:CreateToggle({
   Name = "Auto Farm Level [TWEEN 15 STUDS + KILL AURA]",
   CurrentValue = false,
   Flag = "AutoFarmV6",
   Callback = function(Value)
        getgenv().AutoFarm = Value
        while getgenv().AutoFarm do task.wait()
            pcall(function()
                local Data = GetQuest()
                local Best = GetBestWeapon()
                Status:Set("Lv."..Player.Data.Level.Value.." | "..Data.Mob.." | "..Best.." | 2800")

                if not Player.PlayerGui.Main.Quest.Visible then
                    TweenQuest(Data.Pos)
                    task.wait(0.4)
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", Data.Quest, Data.N)
                end

                for _,Enemy in pairs(workspace.Enemies:GetChildren()) do
                    if Enemy.Name == Data.Mob and Enemy:FindFirstChild("Humanoid") and Enemy.Humanoid.Health > 0 then
                        -- BRING
                        if getgenv().Bring then
                            for _,Other in pairs(workspace.Enemies:GetChildren()) do
                                if Other.Name == Data.Mob and (Other.HumanoidRootPart.Position - Enemy.HumanoidRootPart.Position).Magnitude < 400 then
                                    Other.HumanoidRootPart.CFrame = Enemy.HumanoidRootPart.CFrame
                                    Other.HumanoidRootPart.CanCollide = false
                                    Other.Humanoid.WalkSpeed = 0
                                end
                            end
                        end

                        -- TWEEN EM CIMA DO MOB (NÃO TP)
                        repeat
                            if not getgenv().AutoFarm then break end
                            local Above = Enemy.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().FarmHeight, 2)
                            TweenMob(Above)

                            -- EQUIPA E KILL AURA
                            local Tool = Player.Backpack:FindFirstChild(Best) or Player.Character:FindFirstChild(Best)
                            if Tool then Player.Character.Humanoid:EquipTool(Tool) Tool:Activate() end
                            game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Attack", true)
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Buso")
                            task.wait(0.1)
                        until Enemy.Humanoid.Health <= 0 or not Enemy.Parent
                    end
                end
            end)
        end
   end,
})

