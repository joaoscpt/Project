function GetQuest()
    local MyLevel = Player.Data.Level.Value
    local Q = QuestTable[1]
    for i = #QuestTable, 1, -1 do if MyLevel >= QuestTable[i].L then Q = QuestTable[i] break end end
    return Q
end

local MainTab = Window:CreateTab("Auto Farm 2800", 4483362458)

MainTab:CreateToggle({
   Name = "Auto Farm Level [FINAL]",
   CurrentValue = false,
   Flag = "AutoFarmV11",
   Callback = function(Value)
        getgenv().AutoFarm = Value
        while getgenv().AutoFarm do task.wait()
            pcall(function()
                local Data = GetQuest()
                local Best = GetBestWeapon()
                local HRP = Player.Character.HumanoidRootPart

                if not Player.PlayerGui.Main.Quest.Visible then
                    NoFall(false)
                    HRP.Anchored = false
                    if (Data.Pos.Position - HRP.Position).Magnitude > 8000 then HRP.CFrame = Data.Pos * CFrame.new(0,20,0) task.wait(0.5)
                    else game:GetService("TweenService"):Create(HRP, TweenInfo.new((Data.Pos.Position - HRP.Position).Magnitude/280, Enum.EasingStyle.Linear), {CFrame = Data.Pos}):Play() task.wait(1) end
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", Data.Quest, Data.N)
                end

                local FirstMob = nil
                for _,v in pairs(workspace.Enemies:GetChildren()) do if v.Name == Data.Mob and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then FirstMob = v break end end

                if FirstMob then
                    local Anchor = FirstMob.HumanoidRootPart.CFrame
                    NoFall(true)

                    -- HAKI SÓ UMA VEZ
                    if not Player.Character:FindFirstChild("HasBuso") then
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Buso")
                        task.wait(0.5)
                    end

                    repeat
                        if not getgenv().AutoFarm or not FirstMob.Parent or FirstMob.Humanoid.Health <= 0 then break end

                        HRP.CFrame = Anchor * CFrame.new(0, getgenv().FarmHeight, 0)

                        -- TRAVA E HITBOX EM TODOS
                        for _,Mob in pairs(workspace.Enemies:GetChildren()) do
                            if Mob.Name == Data.Mob and Mob:FindFirstChild("HumanoidRootPart") and Mob.Humanoid.Health > 0 and (Mob.HumanoidRootPart.Position - Anchor.Position).Magnitude < 500 then
                                Mob.HumanoidRootPart.Anchored = true
                                Mob.HumanoidRootPart.CFrame = Anchor
                                Mob.HumanoidRootPart.Size = Vector3.new(100,100,100)
                                Mob.HumanoidRootPart.CanCollide = false
                                Mob.Humanoid.WalkSpeed = 0
                                Mob.Humanoid.JumpPower = 0
                            end
                        end

                        local Tool = Player.Backpack:FindFirstChild(Best) or Player.Character:FindFirstChild(Best)
                        if Tool then Player.Character.Humanoid:EquipTool(Tool) end

                        FastAttack()
                        task.wait(0.05)
                    until FirstMob.Humanoid.Health <= 0 or not getgenv().AutoFarm

                    NoFall(false)
                    HRP.Anchored = false
                    for _,Mob in pairs(workspace.Enemies:GetChildren()) do if Mob:FindFirstChild("HumanoidRootPart") then Mob.HumanoidRootPart.Anchored = false end end
                end
            end)
        end
        NoFall(false)
        Player.Character.HumanoidRootPart.Anchored = false
   end,
})
