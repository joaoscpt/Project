MainTab:CreateToggle({
   Name = "Ativar Auto Farm com Tool",
   CurrentValue = false,
   Flag = "AutoFarmFix",
   Callback = function(Value)
        getgenv().AutoFarm = Value
        while getgenv().AutoFarm do task.wait()
            pcall(function()
                if not getgenv().SelectedWeapon then Status:Set("ERRO: Selecione uma arma na aba Arma / Tool!") return end
                local Data = GetQuest()
                Status:Set("Missão: "..Data.Mob.." | Level "..Player.Data.Level.Value)

                if not Player.PlayerGui.Main.Quest.Visible then
                    SmartTween(Data.Pos)
                    task.wait(0.5)
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", Data.Quest, Data.N)
                end

                for _,Enemy in pairs(workspace.Enemies:GetChildren()) do
                    if Enemy.Name == Data.Mob and Enemy:FindFirstChild("Humanoid") and Enemy.Humanoid.Health > 0 then
                        local HRP = Enemy.HumanoidRootPart
                        if getgenv().Bring then
                            HRP.CanCollide = false
                            Enemy.Humanoid.WalkSpeed = 0
                            HRP.CFrame = HRP.CFrame
                            for _,Other in pairs(workspace.Enemies:GetChildren()) do
                                if Other.Name == Data.Mob and (Other.HumanoidRootPart.Position - HRP.Position).Magnitude < 400 then
                                    Other.HumanoidRootPart.CFrame = HRP.CFrame
                                end
                            end
                        end
                        -- 15 studs acima
                        local Pos = HRP.CFrame * CFrame.new(0, getgenv().FarmHeight, 2)
                        Player.Character.HumanoidRootPart.CFrame = Pos
                        EquipWeapon()
                        Attack()
                    end
                end
            end)
        end
   end,
})
