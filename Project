local Player = game.Players.LocalPlayer

function GetBestWeapon()
    local t = {}
    for _,v in pairs(Player.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(t, v) end end
    for _,v in pairs(Player.Character:GetChildren()) do if v:IsA("Tool") then table.insert(t, v) end end
    for _,v in pairs(t) do if v.ToolTip == "Melee" then return v.Name end end
    for _,v in pairs(t) do if v.ToolTip == "Sword" then return v.Name end end
    if #t > 0 then return t[1].Name end return nil
end

function NoFall(state)
    local HRP = Player.Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    if state then
        if HRP:FindFirstChild("NoFallBV") then HRP.NoFallBV:Destroy() end
        if HRP:FindFirstChild("NoFallBG") then HRP.NoFallBG:Destroy() end
        local BV = Instance.new("BodyVelocity")
        BV.Name = "NoFallBV"
        BV.Velocity = Vector3.new(0,0,0)
        BV.MaxForce = Vector3.new(9e9,9e9)
        BV.Parent = HRP
        local BG = Instance.new("BodyGyro")
        BG.Name = "NoFallBG"
        BG.MaxTorque = Vector3.new(9e9,9e9)
        BG.CFrame = HRP.CFrame
        BG.Parent = HRP
    else
        if HRP:FindFirstChild("NoFallBV") then HRP.NoFallBV:Destroy() end
        if HRP:FindFirstChild("NoFallBG") then HRP.NoFallBG:Destroy() end
    end
end

function FastAttack()
    local Char = Player.Character
    local Tool = Char:FindFirstChildOfClass("Tool")
    if Tool then
        Tool:Activate()
        pcall(function()
            local Combat = require(Player.PlayerScripts:WaitForChild("CombatFramework"))
            local Controller = Combat.activeController
            Controller.timeToNextAttack = 0
            Controller.hitboxMagnitude = 60
            Controller:attack()
        end)
        game:GetService("VirtualUser"):CaptureController()
        game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Attack", true)
    end
end

