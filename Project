-- DROPDOWN DE ARMAS
local function GetWeapons()
    local list = {}
    for _,v in pairs(Player.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(list, v.Name) end end
    for _,v in pairs(Player.Character:GetChildren()) do if v:IsA("Tool") then table.insert(list, v.Name) end end
    return list
end

local WeaponDropdown = WeaponTab:CreateDropdown({
   Name = "Selecionar Tool (Melee / Espada / Gun)",
   Options = GetWeapons(),
   CurrentOption = "",
   Flag = "WeaponFlag",
   Callback = function(Option)
        getgenv().SelectedWeapon = Option[1] or Option
        Status:Set("Arma selecionada: "..getgenv().SelectedWeapon)
   end,
})

WeaponTab:CreateButton({Name = "Atualizar Lista de Armas", Callback = function() WeaponDropdown:Refresh(GetWeapons()) end})

