function GetQuest()
    local MyLevel = Player.Data.Level.Value
    local Q = QuestTable[1]
    for i = #QuestTable, 1, -1 do if MyLevel >= QuestTable[i].L then Q = QuestTable[i] break end end
    return Q
end

local MainTab = Window:CreateTab("Auto Farm 1-2800", 4483362458)
local Status = MainTab:CreateLabel("MAX 2800 | Trava 15 Studs + Aura")

MainTab:CreateToggle({
   Name = "Auto Farm Level [TRAVA + KILL AURA]",
   CurrentValue = false,
   Flag = "AutoFarmV7",
   Callback = function(Value)
        getgenv().AutoFarm = Value
        while getgenv().AutoFarm do task.wait()
            pcall(function()
                local Data = GetQuest()
                local Best = GetBestWeapon()

                if not Player.PlayerGui.Main.Quest.Visible then
                    TweenQuest(Data.Pos)
                    task.wait(0.3)
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", Data.Quest, Data.N)
                end

                local EnemyFound = nil
                for _,Enemy in pairs(workspace.Enemies:GetChildren()) do
                    if Enemy.Name == Data.Mob and Enemy:FindFirstChild("Humanoid") and Enemy.Humanoid.Health > 0 then EnemyFound = Enemy break end
                end

                if EnemyFound then
                    -- BRING
                    if getgenv().Bring then
                        for _,Other in pairs(workspace.Enemies:GetChildren()) do
                            if Other.Name == Data.Mob and (Other.HumanoidRootPart.Position - EnemyFound.HumanoidRootPart.Position).Magnitude < 400 then
                                Other.HumanoidRootPart.CFrame = EnemyFound.HumanoidRootPart.CFrame
                                Other.HumanoidRootPart.CanCollide = false
                                Other.Humanoid.WalkSpeed = 0
                                Other.Humanoid.JumpPower = 0
                            end
                        end
                    end

                    -- TRAVA 15 STUDS EM CIMA - NÃO CAI MAIS
                    repeat
                        if not getgenv().AutoFarm then break end
                        if not EnemyFound.Parent or EnemyFound.Humanoid.Health <= 0 then break end

                        local AbovePos = EnemyFound.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().FarmHeight, 0)
                        Player.Character.HumanoidRootPart.CFrame = AbovePos
                        Player.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                        Player.Character.Humanoid:ChangeState(11)

                        local Tool = Player.Backpack:FindFirstChild(Best) or Player.Character:FindFirstChild(Best)
                        if Tool then Player.Character.Humanoid:EquipTool(Tool) end

                        -- KILL AURA REAL - BATE EM TODOS PERTO
                        for _,CloseMob in pairs(workspace.Enemies:GetChildren()) do
                            if CloseMob:FindFirstChild("HumanoidRootPart") and (CloseMob.HumanoidRootPart.Position - Player.Character.HumanoidRootPart.Position).Magnitude < 25 then
                                game:GetService("VirtualUser"):CaptureController()
                                game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
                                game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Attack", true)
                            end
                        end

                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Buso")
                        task.wait()
                    until EnemyFound.Humanoid.Health <= 0 or not getgenv().AutoFarm
                end
            end)
        end
   end,
})

