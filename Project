function SmartTween(CF)
    local HRP = Player.Character.HumanoidRootPart
    local Dist = (CF.Position - HRP.Position).Magnitude
    -- SE FOR MUITO LONGE (Navio Assombrado, Haunted, etc) USA BYPASS
    if Dist > 8000 then
        Rayfield:Notify({Title = "Ilha muito longe!", Content = "Usando Portal Bypass pro "..tostring(math.floor(Dist)).." studs", Duration = 3})
        HRP.CFrame = CF * CFrame.new(0,20,0)
        task.wait(0.8)
        return
    end
    local Tween = TweenService:Create(HRP, TweenInfo.new(Dist/280, Enum.EasingStyle.Linear), {CFrame = CF})
    Tween:Play()
    Tween.Completed:Wait()
end

function EquipWeapon()
    if not getgenv().SelectedWeapon then return end
    -- Procura na mochila e no char
    local Tool = Player.Backpack:FindFirstChild(getgenv().SelectedWeapon) or Player.Character:FindFirstChild(getgenv().SelectedWeapon)
    if Tool then
        Player.Character.Humanoid:EquipTool(Tool)
        -- Ativa Haki
        if not Player.Character:FindFirstChild("HasBuso") then
            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Buso")
        end
    end
end

function Attack()
    local Char = Player.Character
    local Tool = Char:FindFirstChildOfClass("Tool")
    if Tool then
        Tool:Activate()
        game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
        -- Fast Attack real
        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Attack", true)
    end
end

