function GetQuest()
    local MyLevel = Player.Data.Level.Value
    local Q = QuestTable[1]
    for i = #QuestTable, 1, -1 do if MyLevel >= QuestTable[i].L then Q = QuestTable[i] break end end
    return Q
end

local MainTab = Window:CreateTab("Auto Farm 2800", 4483362458)
local Status = MainTab:CreateLabel("MAX 2800 | Bring Fixo + Hitbox 100")

MainTab:CreateToggle({
   Name = "Auto Farm Level [BRING FIXO + AURA REAL]",
   CurrentValue = false,
   Flag = "AutoFarmV9",
   Callback = function(Value)
        getgenv().AutoFarm = Value
        if Value then Player.Character.Humanoid.PlatformStand = true else Player.Character.Humanoid.PlatformStand = false end

        while getgenv().AutoFarm do task.wait()
            pcall(function()
                local Data = GetQuest()
                local Best = GetBestWeapon()
                Status:Set("Lv."..Player.Data.Level.Value.." | "..Data.Mob.." | Hitbox: "..getgenv().Hitbox)

                if not Player.PlayerGui.Main.Quest.Visible then
                    local HRP = Player.Character.HumanoidRootPart
                    if (Data.Pos.Position - HRP.Position).Magnitude > 8000 then HRP.CFrame = Data.Pos * CFrame.new(0,20,0) task.wait(0.5)
                    else game:GetService("TweenService"):Create(HRP, TweenInfo.new((Data.Pos.Position - HRP.Position).Magnitude/280, Enum.EasingStyle.Linear), {CFrame = Data.Pos}):Play() task.wait(1) end
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", Data.Quest, Data.N)
                end

                local FirstMob = nil
                for _,v in pairs(workspace.Enemies:GetChildren()) do if v.Name == Data.Mob and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then FirstMob = v break end end

                if FirstMob then
                    local Anchor = FirstMob.HumanoidRootPart.CFrame -- ANCORA FIXA, NÃO SEGUE O MOB

                    repeat
                        if not getgenv().AutoFarm or not FirstMob.Parent or FirstMob.Humanoid.Health <= 0 then break end
                        local HRP = Player.Character.HumanoidRootPart

                        -- TRAVA EM CIMA DA ANCORA
                        HRP.CFrame = Anchor * CFrame.new(0, getgenv().FarmHeight, 0)
                        HRP.Velocity = Vector3.new(0,0,0)
                        Player.Character.Humanoid:ChangeState(11)

                        -- BRING TRAVADO + HITBOX 100 + PARADO
                        for _,Mob in pairs(workspace.Enemies:GetChildren()) do
                            if Mob.Name == Data.Mob and Mob:FindFirstChild("HumanoidRootPart") and Mob.Humanoid.Health > 0 then
                                if (Mob.HumanoidRootPart.Position - Anchor.Position).Magnitude < 500 then
                                    Mob.HumanoidRootPart.CFrame = Anchor
                                    Mob.HumanoidRootPart.Size = Vector3.new(getgenv().Hitbox, getgenv().Hitbox, getgenv().Hitbox)
                                    Mob.HumanoidRootPart.Transparency = 1
                                    Mob.HumanoidRootPart.CanCollide = false
                                    Mob.Humanoid.WalkSpeed = 0
                                    Mob.Humanoid.JumpPower = 0
                                    Mob.Humanoid:ChangeState(14)
                                end
                            end
                        end

                        -- KILL AURA REAL - EQUIPA E SOCA
                        local Tool = Player.Backpack:FindFirstChild(Best) or Player.Character:FindFirstChild(Best)
                        if Tool then
                            Player.Character.Humanoid:EquipTool(Tool)
                            Tool:Activate()
                            game:GetService("VirtualUser"):CaptureController()
                            game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
                            game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Attack", true)
                        end

                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("Buso")
                        task.wait(0.05)
                    until FirstMob.Humanoid.Health <= 0 or not getgenv().AutoFarm
                end
            end)
        end
        Player.Character.Humanoid.PlatformStand = false
   end,
})

