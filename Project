function GetQuest()
    local MyLevel = Player.Data.Level.Value
    local Q = QuestTable[1]
    for i = #QuestTable, 1, -1 do
        if MyLevel >= QuestTable[i].L then Q = QuestTable[i] break end
    end
    return Q
end

-- ABAS RAYFIELD
local MainTab = Window:CreateTab("Auto Farm Level", 4483362458)
local SettingsTab = Window:CreateTab("Configurações", 4483362458)

MainTab:CreateSection("Farm Universal 1-2800")

local StatusLabel = MainTab:CreateLabel("Status: Aguardando...")

MainTab:CreateToggle({
   Name = "Ativar Auto Farm [Tween + 15 Studs]",
   CurrentValue = false,
   Flag = "AutoFarmToggle",
   Callback = function(Value)
        getgenv().AutoFarm = Value
        while getgenv().AutoFarm do task.wait()
            pcall(function()
                local Data = GetQuest()
                StatusLabel:Set("Farmando: "..Data.Mob.." | Level: "..Player.Data.Level.Value.." | Sea: "..(Player.Data.Level.Value < 700 and "1" or Player.Data.Level.Value < 1500 and "2" or "3"))

                -- 1. TWEEN até NPC e pegar missão
                if not Player.PlayerGui.Main.Quest.Visible then
                    TweenTo(Data.Pos)
                    task.wait(0.4)
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", Data.Quest, Data.N)
                end

                -- 2. Farmar com 15 studs acima
                for _,Enemy in pairs(workspace.Enemies:GetChildren()) do
                    if Enemy.Name == Data.Mob and Enemy:FindFirstChild("Humanoid") and Enemy.Humanoid.Health > 0 then
                        local HRP = Enemy.HumanoidRootPart

                        -- Bring + trava o mob
                        if getgenv().Bring then
                            HRP.CanCollide = false
                            Enemy.Humanoid.WalkSpeed = 0
                            for _,Other in pairs(workspace.Enemies:GetChildren()) do
                                if Other.Name == Data.Mob and (Other.HumanoidRootPart.Position - HRP.Position).Magnitude < 350 then
                                    Other.HumanoidRootPart.CFrame = HRP.CFrame
                                end
                            end
                        end

                        -- Fica 15 studs acima
                        local FarmPos = HRP.CFrame * CFrame.new(0, getgenv().FarmHeight, 5)
                        Player.Character.HumanoidRootPart.CFrame = FarmPos

                        -- Kill Aura
                        if getgenv().KillAura then
                            game:GetService("VirtualUser"):CaptureController()
                            game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
                        end
                    end
                end
            end)
        end
   end,
})

